{
  "schemaVersion": 1,
  "id": "lss",
  "version": "${version}",
  "name": "LOD Server Support",
  "description": "Voxy multiplayer support (unofficial). Enables players with Voxy to see fully rendered terrain out to hundreds of chunks on multiplayer servers without needing to explore the world first.",
  "authors": [
    "VoX"
  ],
  "contact": {
    "sources": "https://github.com/VoX/lod-server-support"
  },
  "license": "MIT",
  "icon": "assets/lss/icon.png",
  "accessWidener": "lss.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.vox.lss.LSSMod"
    ],
    "client": [
      "dev.vox.lss.LSSClient"
    ],
    "sodium:config_api_user": [
      "dev.vox.lss.config.LSSConfigMenu"
    ],
    "modmenu": [
      "dev.vox.lss.config.LSSModMenuIntegration"
    ]
  },
  "mixins": [
    "lss.mixins.json",
    "lss-trace.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/sqlite-jdbc-slim.jar"
    },
    {
      "file": "META-INF/jars/zstd-jni-slim.jar"
    }
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "fabricloader": ">=0.18.4",
    "fabric-api": ">=0.152.1"
  },
  "suggests": {
    "sodium": ">=0.9.0",
    "modmenu": "*",
    "voxy": ">=0.2.17-alpha"
  }
}
